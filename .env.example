# Public, read-only SEARCH credentials used by welcometothejungle.com itself (the ones your browser
# sends when you search for a job). How to find them: references/setup.md
WTTJ_ALGOLIA_APP=
WTTJ_ALGOLIA_KEY=
# Optional: index sorted by publication date (default value)
WTTJ_ALGOLIA_INDEX=wttj_jobs_production_fr_published_at_desc
